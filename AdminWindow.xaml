<Window x:Class="navigationshurely.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:navigationshurely"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800"
        ResizeMode="NoResize"
        SnapsToDevicePixels="true"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        
        x:Name="AdminScreen"
        
        Loaded="AdminScreen_Loaded"
        ShowInTaskbar="false">

    <Border x:Name="AdminSession"
            CornerRadius="15, 0, 0, 15"
            RenderTransformOrigin="1,1"
            BorderThickness="4"
            BorderBrush="#6b6b6a"
            Background="#2e2e2e">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PopupScale" ScaleX="0" ScaleY="0" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Terminal output -->
            <ScrollViewer x:Name="TerminalScrollViewer"
                  Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="30">

                <ItemsControl x:Name="TerminalOutput">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <!-- Existing command input -->
            <TextBox x:Name="AdminInputDisplay"
             Grid.Row="1"
             IsReadOnly="True"
             IsReadOnlyCaretVisible="True"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             BorderThickness="0"
             Background="Transparent"
             Padding="30"
             Margin="0"
             Foreground="White"
             CaretBrush="White"
             HorizontalAlignment="Left"
             VerticalAlignment="Bottom"
             FontFamily="Consolas"
             FontSize="20"
             TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Hidden"
             VerticalScrollBarVisibility="Hidden"
             VerticalContentAlignment="Center"
             PreviewKeyDown="AdminInputDisplay_PreviewKeyDown"
             PreviewTextInput="AdminInputDisplay_PreviewTextInput"/>

        </Grid>

    </Border>

</Window>
