                <TextBlock Style="{StaticResource SectionHeader}" Text="2. SWITCHING MODES"/>
                <TextBlock Style="{StaticResource BodyText}" Text="At a command boundary in BOOK, CHAPTER, VERSE or SEMICOLON mode, press the corresponding mode key. The key changes the parser mode; it does not itself navigate to another verse."/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
