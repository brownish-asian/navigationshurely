<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:navigationshurely" x:Class="navigationshurely.HelpWindow" mc:Ignorable="d" PreviewKeyDown="Window_PreviewKeyDown" Title="NavigationShurely — Help" Height="450" Width="800" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" Background="#111111">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FFD54F"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,28,0,14"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
        <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="SmallBody" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="TableHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FFD54F"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TableCell" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ExampleText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FFD54F"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="AliasLine" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="AliasHeading" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FFD54F"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>
    <Grid Background="#111111">
        <ScrollViewer x:Name="HelpScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="60">
                <TextBlock Text="NAVIGATIONSHURELY" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Command Grammar &amp; Instruction Manual" Foreground="#AAAAAA" FontSize="20" Margin="0,0,0,10"/>
                <TextBlock Text="A complete keyboard reference for Bible navigation, special commands, search filters and predefined shortcuts. Press Ctrl+Q to exit the application." Foreground="#CCCCCC" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,24"/>

                <TextBlock Style="{StaticResource SectionHeader}" Text="1. BASIC RULES AND NOTATION"/>
                <TextBlock Style="{StaticResource BodyText}" Text="NavigationShurely is a keyboard-driven Bible navigator. Commands are entered by pressing keys in sequence, and their meaning depends on the active navigation or search mode. The input parser starts in BOOK mode. The application restores the saved Bible translation, last verse position, background image and saved marks when those settings are available."/>
                <TextBlock Style="{StaticResource BodyText}" Text="Unless otherwise stated, press command keys consecutively. For example, 3j means press 3 and then j; do not insert a space between them."/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Notation"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Meaning"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="b, c, v"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Press the indicated letter."/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="[Space]"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Press the physical Space key. This is explanatory notation, not text to type."/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="[Enter]"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Press Enter."/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="[Tab]"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Press Tab. Its effect depends on the active mode."/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="[Esc]"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Press Escape."/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="[Backspace]"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Press Backspace."/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Ctrl+D / Ctrl+U"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Hold Ctrl and press the indicated letter; the action depends on the active mode."/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="N"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="A number entered with digit keys, supported letter-to-digit codes, or a mixture."/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="X"/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="One supported character used as a mark identifier."/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="book"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="One exact alias from the 66-book alias reference."/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="."/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="In CHAPTER and VERSE mode, reuse the most recently entered number as an absolute target."/>
                    </Border>
                    <Border Grid.Row="12" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Shift+Tab"/>
                    </Border>
                    <Border Grid.Row="12" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="In SEMICOLON mode, go to the previous background image; this reverses Tab's direction."/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource SubHeader}" Text="The four navigation modes"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Mode"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Purpose"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="BOOK"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Select Bible books and move between them."/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="CHAPTER"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Move between chapters or select a chapter number."/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="VERSE"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Move between verses or select a verse number."/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="SEMICOLON"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Access utility commands, history, marks and verse shortcuts."/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource SectionHeader}" Text="2. SWITCHING MODES"/>
                <TextBlock Style="{StaticResource BodyText}" Text="From an ordinary navigation mode, these keys select how subsequent keystrokes are interpreted. The switch itself does not move to another verse."/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Key"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Result"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="b"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="BOOK mode"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="c"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="CHAPTER mode"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="v"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="VERSE mode"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text=";"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="SEMICOLON mode"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="/"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Enter Search mode"/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource BodyText}" Text="For example, while in VERSE mode, press b and then the desired book alias to select a book. BOOK is already the initial mode, so pressing b while already in BOOK mode starts a possible book alias instead of acting as a separate mode switch."/>
                <TextBlock Style="{StaticResource SectionHeader}" Text="3. BOOK MODE — b"/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Select a book by alias"/>
                <TextBlock Style="{StaticResource BodyText}" Text="Enter an exact book alias. The app navigates as soon as the alias is complete; no Enter or Space is required. One-letter aliases execute immediately. For a longer alias, type its characters in sequence; if the entered characters are a valid prefix, continue until the alias is complete."/>
                <TextBlock Style="{StaticResource ExampleText}" Text="ge  → Genesis     ro  → Roma     ua  → Juan     ap  → Apocalipsis&#10;x   → Exodo       p   → I Pedro   y   → Panaghoy"/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Move between books"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Command"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Action"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="j"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Move to the next book."/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="k"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Move to the previous book."/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource BodyText}" Text="Book movement wraps around: forward from the final book returns to Genesis, and backward from Genesis returns to the final book. Only single-step j and k movement is supported here; numeric movement such as 3j is not a BOOK-mode command."/>
                <TextBlock Style="{StaticResource BodyText}" Text="When changing books, the app attempts to preserve the current chapter and verse. If that location does not exist in the destination book, the chapter and verse are constrained to valid positions in that book; selecting a shorter book does not necessarily reset the location to chapter 1."/>
                <TextBlock Style="{StaticResource BodyText}" Text="See Appendix A for the complete, exact list of all 66 book aliases. Ordinary book names or alternative spellings do not replace the defined aliases."/>
                <TextBlock Style="{StaticResource SectionHeader}" Text="4. CHAPTER MODE — c"/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Relative movement"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Command"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Action"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="j"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Move forward one chapter."/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="k"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Move backward one chapter."/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Nj"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Move forward N chapters."/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Nk"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" FontSize="15" TextWrapping="Wrap" Text="Move backward N chapters."/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource ExampleText}" Text="j     next chapter&#10;k     previous chapter&#10;3j    forward 3 chapters&#10;2k    backward 2 chapters&#10;13j   forward 13 chapters&#10;utj   also forward 13 chapters (u = 1, t = 3)"/>
                <TextBlock Style="{StaticResource BodyText}" Text="Relative chapter movement follows chapter order throughout the Bible. Moving beyond the final chapter wraps to the beginning; moving backward past the first chapter wraps to the end. The current verse number is preserved where possible and adjusted if the destination chapter has fewer verses."/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Absolute chapter selection"/>
