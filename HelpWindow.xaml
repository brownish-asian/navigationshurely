                        <TextBlock Style="{StaticResource TableCell}" Text="Move backward N verses."/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource ExampleText}" Text="j      → next verse&#10;k      → previous verse&#10;3j     → forward 3 verses&#10;2k     → backward 2 verses&#10;13j    → forward 13 verses&#10;utj    → forward 13 verses (u=1, t=3)"/>
                <TextBlock Style="{StaticResource BodyText}" Text="Verse movement follows the continuous order of Bible verses. It can cross chapter and book boundaries and wraps around the beginning or end of the Bible."/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Absolute verse selection"/>
                <TextBlock Style="{StaticResource BodyText}" Text="Syntax: N[Space]. Enter the desired verse number, then press Space. The current book and chapter remain unchanged. The requested verse is constrained to a valid verse in the current chapter."/>
                <TextBlock Style="{StaticResource ExampleText}" Text="5[Space]    → select verse 5 of the current chapter&#10;12[Space]   → select verse 12 of the current chapter"/>
                <TextBlock Style="{StaticResource BodyText}" Text="A number by itself is not a complete book–chapter–verse reference. The period shortcut described in Section 6 can reuse the last entered number as an absolute chapter or verse target; before any number is entered, the remembered value is 1."/>
                <TextBlock Style="{StaticResource SectionHeader}" Text="6. NUMERIC INPUT AND LETTER-TO-DIGIT CODES"/>
                <TextBlock Style="{StaticResource BodyText}" Text="In CHAPTER and VERSE modes, ordinary digit keys and the regular letter codes below can be combined to build a decimal number. For example, u followed by t forms 13. The same regular digit codes can be used when entering numeric chapter or verse filters in Search and numeric movement counts in CHOICE mode."/>
