                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" Text="Move to the previous book."/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource BodyText}" Text="Book movement wraps around the 66-book sequence. Moving forward from Revelation returns to Genesis; moving backward from Genesis returns to Revelation. Only single-step j and k movement is supported in BOOK mode: numeric commands such as 3j are not BOOK-mode commands."/>
                <TextBlock Style="{StaticResource BodyText}" Text="When changing books, the navigator tries to retain the current chapter and verse. If the destination book is shorter, the chapter and verse are constrained to valid positions in that book."/>
                <TextBlock Style="{StaticResource SectionHeader}" Text="4. CHAPTER MODE — c"/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Relative movement"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
