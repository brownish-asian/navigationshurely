    <Grid Background="#111111">
        <ScrollViewer x:Name="HelpScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="60">
                <TextBlock Text="NAVIGATIONSHURELY" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Keyboard Reference &amp; Operating Manual" Foreground="#AAAAAA" FontSize="20" Margin="0,0,0,10"/>
                <TextBlock Text="A source-aligned guide to the current navigation parser, Bible navigator, search workflow, interface layouts, utility commands and exact alias dictionaries." Foreground="#CCCCCC" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,24"/>

                <TextBlock Style="{StaticResource SectionHeader}" Text="1. GETTING STARTED AND NOTATION"/>
                <TextBlock Style="{StaticResource BodyText}" Text="NavigationShurely is operated primarily through sequences of keyboard commands. The command parser starts in BOOK mode. The meaning of a key depends on the active mode and, in some modes, on whether a command is already being entered."/>
                <TextBlock Style="{StaticResource BodyText}" Text="Type command sequences consecutively unless a physical key is shown in square brackets. For example, 3j means press 3 and then j. The notation 3[Space] means press 3 and then the Space key; the word Space is not typed."/>
                <TextBlock Style="{StaticResource BodyText}" Text="The application restores the saved verse position, displayed translation, background image, saved marks and preferred interface layout when settings are available. Navigation history is created anew for each application session."/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Notation"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                        <TextBlock Style="{StaticResource TableHeader}" Text="Meaning"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" Text="N"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" Text="A number built from ordinary digit keys, supported letter-to-digit keys, or a mixture."/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" Text="X"/>
