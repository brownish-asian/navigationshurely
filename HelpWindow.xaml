                        <TextBlock Style="{StaticResource TableCell}" Text="Move backward N chapters."/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource ExampleText}" Text="j      → next chapter&#10;k      → previous chapter&#10;3j     → forward 3 chapters&#10;2k     → backward 2 chapters&#10;13j    → forward 13 chapters&#10;utj    → forward 13 chapters (u=1, t=3)"/>
                <TextBlock Style="{StaticResource BodyText}" Text="Chapter movement follows the ordered list of chapters throughout the Bible, not just the current book. It wraps at the beginning and end of the Bible. The current verse number is retained when possible and reduced if the destination chapter has fewer verses."/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Absolute chapter selection"/>
                <TextBlock Style="{StaticResource BodyText}" Text="Syntax: N[Space]. Enter the desired chapter number, then press Space. The current book remains unchanged; the verse number is retained where possible and constrained to a valid verse in the selected chapter."/>
                <TextBlock Style="{StaticResource ExampleText}" Text="3[Space]    → select chapter 3 of the current book&#10;12[Space]   → select chapter 12 of the current book"/>
                <TextBlock Style="{StaticResource SectionHeader}" Text="5. VERSE MODE — v"/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Relative movement"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
