                        <TextBlock Style="{StaticResource TableCell}" Text="/"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,7,8,7">
                        <TextBlock Style="{StaticResource TableCell}" Text="Enter Search mode."/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource BodyText}" Text="When Search is active, / exits Search and returns to the navigation mode that was active immediately before Search began. Tab and Shift+Tab cycle among QUERY, FILTER and CHOICE; see Section 8."/>
                <TextBlock Style="{StaticResource BodyText}" Text="BOOK mode is a special case: it is the initial mode, and b at the start of a BOOK-mode command begins a possible book alias. To choose a book while already in BOOK mode, type its alias directly. From CHAPTER or VERSE mode, press b first, then type the book alias."/>
                <TextBlock Style="{StaticResource SectionHeader}" Text="3. BOOK MODE — b"/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Select a book by its alias"/>
                <TextBlock Style="{StaticResource BodyText}" Text="Enter one exact book alias from Appendix A. The destination is selected as soon as the complete alias has been entered; no Enter or Space is required. One-character aliases execute immediately. Longer aliases are accepted as their characters are typed when the entered sequence is a valid prefix."/>
                <TextBlock Style="{StaticResource ExampleText}" Text="ge  → Genesis&#10;ro  → Roma&#10;ua  → Juan&#10;ap  → Apocalipsis&#10;x   → Exodo&#10;p   → I Pedro&#10;y   → Panaghoy"/>
                <TextBlock Style="{StaticResource SubHeader}" Text="Move between books"/>
