                <TextBlock Style="{StaticResource BodyText}" Text="At the start of a command in BOOK, CHAPTER, VERSE or SEMICOLON mode, press / to open Search. The search interface shows the query, available filters, result count and matching-verse list. Press / again to leave Search and return to the mode that was active before Search was opened."/>
                <TextBlock Style="{StaticResource BodyText}" Text="Search has three main states: QUERY, FILTER and CHOICE. Tab cycles QUERY → FILTER → CHOICE → QUERY. Shift+Tab cycles in the reverse direction: QUERY → CHOICE → FILTER → QUERY."/>
