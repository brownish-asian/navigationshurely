                <TextBlock Style="{StaticResource BodyText}" Text="When you type a valid one-, two- or three-letter prefix after ;, the right-hand list can show matching alias suggestions and their verse references. Continue typing to complete an alias. Backspace removes the last prefix character; Ctrl+Backspace clears the unfinished prefix. You can click a suggestion to navigate to its verse and cancel the unfinished prefix."/>
                <TextBlock Style="{StaticResource BodyText}" Text="The main interface also displays the semicolon alias for the current verse when one exists. If no alias is defined for the current verse, the display says that no alias was found."/>
                <TextBlock Style="{StaticResource BodyText}" Text="Navigation history contains up to 100 visited positions and is session-only. Moving to a new verse after moving backward discards the old forward branch of the history."/>
