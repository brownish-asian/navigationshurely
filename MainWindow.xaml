<Window x:Class="navigationshurely.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:navigationshurely" mc:Ignorable="d" Title="NavigationShurely" Height="450" Width="800" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Existing search results: display the Verse.ToString() -->
        <DataTemplate x:Key="SearchVerseTemplate">
            <TextBlock Text="{Binding}"
                   Foreground="#F1F5F9"
                   FontFamily="Consolas"
                   FontWeight="SemiBold"
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   LineHeight="19"
                   SnapsToDevicePixels="True"/>
        </DataTemplate>

        <!-- Marked verses: display the key and verse -->
        <DataTemplate x:Key="MarkedVerseTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Compact shortcut key -->
                <Border Grid.Column="0"
                Background="#303F56"
                BorderBrush="#60748E"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0"
                Margin="-5,0,0,0"
                VerticalAlignment="Center">

                    <TextBlock Text="{Binding KeyText}"
                       Foreground="#FFFFFF"
                       FontFamily="Consolas"
                       FontWeight="Bold"
                       FontSize="13"
                       TextAlignment="Center"
                       VerticalAlignment="Center"/>
                </Border>

                <!-- Verse title -->
                <TextBlock Grid.Column="1"
                   Text="{Binding VerseText}"
                   Foreground="#F1F5F9"
                   FontFamily="Consolas"
                   FontSize="10"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="4,0,0,0"
                   Padding="0"
                   TextTrimming="None"/>
            </Grid>
        </DataTemplate>
        <!-- Shared colour palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FFEEFF36"/>
        <SolidColorBrush x:Key="CoolAccentBrush" Color="#FF54C8FF"/>
        <SolidColorBrush x:Key="GlassBrush" Color="#55071320"/>
        <SolidColorBrush x:Key="SoftWhiteBrush" Color="#FFF3F6FA"/>

        <!-- Keyboard hints -->
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE1EAF4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="5"
                                      ShadowDepth="1"
                                      Opacity="0.9"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode indicator -->
        <Style x:Key="ModeStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="8"
                                      ShadowDepth="1"
                                      Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush x:Name="BackgroundBrush" ImageSource="images/dbw59.jpg" Stretch="UniformToFill"/>
    </Window.Background>
    <Grid>
        <!--
            Responsive layout:
            - Side columns act as proportional gutters, with a minimum width for readability.
            - The centre column grows/shrinks with the available screen width.
            - The header keeps its natural height; the verse area receives the remaining height.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="80"/>
            <ColumnDefinition Width="90*"/>
            <ColumnDefinition Width="5*" MinWidth="80"/>
        </Grid.ColumnDefinitions>

        <!-- Header: aligned with the main text column rather than positioned by a fixed left margin. -->
        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,60,0,0">
            <TextBlock x:Name="titleBox" Text="GENESIS 1:1" Background="Transparent" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="50" HorizontalAlignment="Left"/>
            <TextBlock x:Name="translationBox" Text="ANG DATING BIBLIA" Background="Transparent" Foreground="#FFEEFF36" FontFamily="Arial" FontWeight="Bold" FontStyle="Italic" FontSize="30" HorizontalAlignment="Left"/>
        </StackPanel>
        <!-- Verse area: its width comes from the centre Grid column. -->
        <Grid x:Name="verseContainer" Grid.Row="1" Grid.Column="1" Margin="0,20,0,80">
            <TextBlock x:Name="verseBox" Text="" Background="Transparent" Foreground="White" FontFamily="Arial" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="59"/>
        </Grid>
        <!-- Right-side dynamic list -->
        <ListView x:Name="rightList"
          Grid.Row="1"
          Grid.Column="2"
          MinWidth="72"
          MaxHeight="{Binding ActualHeight, ElementName=verseContainer}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          Margin="0,20,5,100"
          Background="Transparent"
          BorderThickness="0"
          Padding="0"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

            <ListView.Resources>
                <!-- Remove the default ListView selection and hover visuals -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="#252B38"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                         Color="#252B38"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                         Color="#FFFFFF"/>
            </ListView.Resources>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">

                    <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

                    <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

                    <Setter Property="Padding"
                    Value="0"/>

                    <Setter Property="Margin"
                    Value="0,3"/>

                    <Setter Property="Background"
                    Value="Transparent"/>

                    <Setter Property="BorderThickness"
                    Value="0"/>

                    <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">

                                <Border x:Name="ItemBorder"
                                Background="#B30B0F16"
                                BorderBrush="{Binding BorderColor}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="4,9"
                                SnapsToDevicePixels="True">

                                    <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="False"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <!-- Gentle highlight when the pointer enters -->
                                    <Trigger Property="IsMouseOver"
                                     Value="True">
                                        <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#E61A2230"/>
                                        <Setter TargetName="ItemBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                                    </Trigger>

                                    <!-- Keep keyboard selection visually restrained -->
                                    <Trigger Property="IsSelected"
                                     Value="True">
                                        <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#E6212938"/>
                                    </Trigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected"
                                               Value="True"/>
                                            <Condition Property="IsMouseOver"
                                               Value="True"/>
                                        </MultiTrigger.Conditions>

                                        <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#F02A3547"/>
                                    </MultiTrigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                       Foreground="#F1F5F9"
                       FontFamily="Consolas"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       LineHeight="19"
                       SnapsToDevicePixels="True"/>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>


        <!-- Bottom dynamic list -->
        <ListView x:Name="bottomList"
          Grid.Row="1"
          Grid.Column="0"
          Grid.ColumnSpan="2"
          MinHeight="40"
          MaxHeight="50"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Bottom"
          Margin="30,0,0,80"
          Background="Transparent"
          BorderThickness="0"
          Padding="0"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">

                    <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

                    <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

                    <Setter Property="Padding"
                    Value="0"/>

                    <Setter Property="Margin"
                    Value="3,0"/>

                    <Setter Property="Background"
                    Value="Transparent"/>

                    <Setter Property="BorderThickness"
                    Value="0"/>

                    <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">

                                <Border x:Name="ItemBorder"
                                Background="#B30B0F16"
                                BorderBrush="{Binding BorderColor}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="9,5"
                                SnapsToDevicePixels="True">

                                    <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="False"/>

                                </Border>

 

                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                       Foreground="#F1F5F9"
                       FontFamily="Consolas"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="NoWrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True"/>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
        <!-- Mode indicator -->
        <TextBlock x:Name="frequencyBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,70" Foreground="#FF9FCBDF" FontFamily="Consolas" FontWeight="Bold" FontSize="17"/>
        <!-- Alias indicator -->
        <TextBlock x:Name="aliasBox"
           Grid.Row="1"
           Grid.Column="0"
           Grid.ColumnSpan="3"
           Text=""
           HorizontalAlignment="Center"
           VerticalAlignment="Bottom"
           Margin="0,0,0,30"
           Foreground="#FF54C8FF"
           FontFamily="Consolas"
           FontWeight="Bold"
           FontSize="17"
           Visibility="Visible"/>
        <TextBlock x:Name="modeBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,30" Style="{StaticResource ModeStyle}"/>
        <!-- Command buffer -->
        <TextBlock x:Name="refreshSearchBox"
                   Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
               Text="Press [Enter] to refresh search"
               Foreground="{StaticResource AccentBrush}"
               FontFamily="Consolas"
               FontWeight="Bold"
               FontSize="16"
               VerticalAlignment="Bottom"
               HorizontalAlignment="Center"
               Margin="0,0,20,50"
               Visibility="Hidden"/>
        <TextBlock x:Name="bufferBox"
           Grid.Row="1"
           Grid.Column="1"
           Grid.ColumnSpan="2"
           Text=""
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Margin="0,0,40,0"
           Foreground="#182126"
           FontFamily="Consolas"
           FontWeight="Bold"
           FontSize="20"/>
        <!-- Hints -->
        <TextBlock x:Name="hintBoxOne" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="[space];f for help" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,50" Style="{StaticResource HintStyle}"/>
        <TextBlock x:Name="hintBoxTwo" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="[space];e to toggle UI" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,20" Style="{StaticResource HintStyle}"/>
    </Grid>
</Window>